{
  "name": "comanda-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace @comanda/mobile",
    "mobile:android": "npm run android --workspace @comanda/mobile",
    "mobile:web": "npm run web --workspace @comanda/mobile",
    "mobile:lint": "npm run lint --workspace @comanda/mobile",
    "web:dev": "npm run dev --workspace @comanda/web",
    "backend:dev": "npm run dev --workspace @comanda/backend"
  }
}
