{
  "expo": {
    "name": "Comanda",
    "slug": "Comanda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-from-jpg.png",
    "scheme": "comanda",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.tuempresa.comanda",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-from-jpg.png"
      },
      "permissions": ["REQUEST_INSTALL_PACKAGES"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ee254c05-f0da-4853-a17f-62687a12cc92"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ee254c05-f0da-4853-a17f-62687a12cc92",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
